<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PulseSurvey" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0"><bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_PulseSurvey" name="АО «Казахтелеком» — Процесс пульс-опросов и аналитики социального климата" processRef="Process_PulseSurvey" /></bpmn:collaboration><bpmn:process id="Process_PulseSurvey" isExecutable="true"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_Keycloak" name="Keycloak SSO &amp; Авторизация"><bpmn:flowNodeRef>StartEvent_Login</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Role</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Admin" name="Админ-панель (HR)"><bpmn:flowNodeRef>Task_CreateSurvey</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_LaunchTimer</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TimerExpired</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ShowAdminReport</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Employee" name="Сотрудник (Диалоговое окно)"><bpmn:flowNodeRef>Task_OpenChat</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Answer5Q</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SaveSealed</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_AI_Core" name="Локальный ИИ (Вскрытие и отчет)"><bpmn:flowNodeRef>Task_UnsealBatch</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CalcMetrics</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GenerateNarrative</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Executive" name="Панель руководства (SRS + Пульс)"><bpmn:flowNodeRef>Task_OpenExecPanel</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ViewSRSDash</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ViewPulseDash</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Done</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_Login" name="Вход через Keycloak SSO" /><bpmn:exclusiveGateway id="Gateway_Role" name="Проверка роли Keycloak" /><bpmn:userTask id="Task_CreateSurvey" name="Создание опроса и установка срока в N дней" /><bpmn:serviceTask id="Task_LaunchTimer" name="Запуск таймера и генерация ссылки/QR" /><bpmn:exclusiveGateway id="Gateway_TimerExpired" name="Срок N дней истек?" /><bpmn:userTask id="Task_ShowAdminReport" name="Просмотр таблицы итогов и отчета ИИ" /><bpmn:userTask id="Task_OpenChat" name="Анонимный вход по QR/ссылке (без Keycloak)" /><bpmn:userTask id="Task_Answer5Q" name="Ответ на 5 строго установленных вопросов" /><bpmn:serviceTask id="Task_SaveSealed" name="Сохранение ответов в запечатанный пул" /><bpmn:serviceTask id="Task_UnsealBatch" name="Вскрытие ответов и пакетный анализ" /><bpmn:serviceTask id="Task_CalcMetrics" name="Расчет таблицы баллов по 5 осям" /><bpmn:serviceTask id="Task_GenerateNarrative" name="Генерация развернутого текстового отчета ИИ" /><bpmn:userTask id="Task_OpenExecPanel" name="Открытие Панели руководства" /><bpmn:userTask id="Task_ViewSRSDash" name="Раздел: Дашборд SRS + Текстовое описание" /><bpmn:userTask id="Task_ViewPulseDash" name="Раздел: Дашборд Пульс + Текстовое описание ИИ" /><bpmn:endEvent id="EndEvent_Done" name="Аналитика изучена руководством" /><bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Login" targetRef="Gateway_Role" /><bpmn:sequenceFlow id="Flow_2" sourceRef="Gateway_Role" targetRef="Task_CreateSurvey" name="ROLE_ADMIN" /><bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_Role" targetRef="Task_OpenExecPanel" name="ROLE_EXECUTIVE" /><bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CreateSurvey" targetRef="Task_LaunchTimer" /><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_LaunchTimer" targetRef="Task_OpenChat" /><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_OpenChat" targetRef="Task_Answer5Q" /><bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Answer5Q" targetRef="Task_SaveSealed" /><bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SaveSealed" targetRef="Gateway_TimerExpired" /><bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_TimerExpired" targetRef="Task_OpenChat" name="Опрос активен" /><bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_TimerExpired" targetRef="Task_UnsealBatch" name="Срок истек" /><bpmn:sequenceFlow id="Flow_11" sourceRef="Task_UnsealBatch" targetRef="Task_CalcMetrics" /><bpmn:sequenceFlow id="Flow_12" sourceRef="Task_CalcMetrics" targetRef="Task_GenerateNarrative" /><bpmn:sequenceFlow id="Flow_13" sourceRef="Task_GenerateNarrative" targetRef="Task_ShowAdminReport" /><bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ShowAdminReport" targetRef="Task_ViewPulseDash" /><bpmn:sequenceFlow id="Flow_15" sourceRef="Task_OpenExecPanel" targetRef="Task_ViewSRSDash" /><bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ViewSRSDash" targetRef="Task_ViewPulseDash" /><bpmn:sequenceFlow id="Flow_17" sourceRef="Task_ViewPulseDash" targetRef="EndEvent_Done" /></bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram_1"><bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1"><bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant_PulseSurvey" isHorizontal="true"><dc:Bounds x="160" y="80" width="1680" height="950" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Keycloak_di" bpmnElement="Lane_Keycloak" isHorizontal="true"><dc:Bounds x="190" y="80" width="1650" height="150" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true"><dc:Bounds x="190" y="230" width="1650" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true"><dc:Bounds x="190" y="430" width="1650" height="190" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_AI_Core_di" bpmnElement="Lane_AI_Core" isHorizontal="true"><dc:Bounds x="190" y="620" width="1650" height="210" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Executive_di" bpmnElement="Lane_Executive" isHorizontal="true"><dc:Bounds x="190" y="830" width="1650" height="200" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="StartEvent_Login_di" bpmnElement="StartEvent_Login"><dc:Bounds x="240" y="137" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_Role_di" bpmnElement="Gateway_Role"><dc:Bounds x="340" y="130" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CreateSurvey_di" bpmnElement="Task_CreateSurvey"><dc:Bounds x="440" y="280" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_LaunchTimer_di" bpmnElement="Task_LaunchTimer"><dc:Bounds x="620" y="280" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Gateway_TimerExpired_di" bpmnElement="Gateway_TimerExpired"><dc:Bounds x="810" y="295" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ShowAdminReport_di" bpmnElement="Task_ShowAdminReport"><dc:Bounds x="1380" y="280" width="150" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_OpenChat_di" bpmnElement="Task_OpenChat"><dc:Bounds x="620" y="480" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Answer5Q_di" bpmnElement="Task_Answer5Q"><dc:Bounds x="800" y="480" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_SaveSealed_di" bpmnElement="Task_SaveSealed"><dc:Bounds x="980" y="480" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_UnsealBatch_di" bpmnElement="Task_UnsealBatch"><dc:Bounds x="920" y="680" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CalcMetrics_di" bpmnElement="Task_CalcMetrics"><dc:Bounds x="1100" y="680" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_GenerateNarrative_di" bpmnElement="Task_GenerateNarrative"><dc:Bounds x="1270" y="680" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_OpenExecPanel_di" bpmnElement="Task_OpenExecPanel"><dc:Bounds x="440" y="890" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ViewSRSDash_di" bpmnElement="Task_ViewSRSDash"><dc:Bounds x="640" y="